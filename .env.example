# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT GATEWAY INTEGRATIONS (India & International)
# Razorpay (India Default - INR)
RAZORPAY_KEY_ID="rzp_test_exampleKey123"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Stripe (Optional International)
STRIPE_PUBLISHABLE_KEY="pk_test_example"
STRIPE_SECRET_KEY="sk_test_example"

# TRANSACTIONAL NOTIFICATIONS (WhatsApp / SMS / Email)
# WhatsApp Business API / Twilio
TWILIO_ACCOUNT_SID="AC_example"
TWILIO_AUTH_TOKEN="your_auth_token"
WHATSAPP_SENDER_NUMBER="whatsapp:+919876543210"

# Resend / SendGrid (Transactional Email for Invoices & DVI Reports)
RESEND_API_KEY="re_example_12345678"
SENDER_EMAIL="service@drivecraftautocare.com"

# GOOGLE MAPS PLATFORM
VITE_GOOGLE_MAPS_API_KEY="AIzaSyExampleKey"

# SUPABASE / POSTGRESQL PERSISTENCE
DATABASE_URL="postgresql://postgres:password@localhost:5432/drivecraft"
SUPABASE_URL="https://example.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."

